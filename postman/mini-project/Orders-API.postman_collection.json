{
  "info": {
    "name": "Orders API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Real-world pattern: log in once, automatically capture the auth token via a test script, and every later request in the collection reuses it via a collection variable - no manual copy-pasting of tokens between requests."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4002" },
    { "key": "authToken", "value": "" },
    { "key": "lastOrderId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"hunter2\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "pm.test('Response contains a token', () => {",
              "  pm.expect(body.token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "// This is the actual mechanism that lets every later request in this",
              "// collection reuse the token automatically - no manual copy-paste.",
              "pm.collectionVariables.set('authToken', body.token);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. List Orders (authenticated)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": "{{baseUrl}}/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is an array', () => {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Create Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"item\": \"Standing desk\",\n  \"quantity\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "pm.test('Order has an id', () => pm.expect(body.id).to.be.a('number'));",
              "pm.test('Item matches what was sent', () => pm.expect(body.item).to.eql('Standing desk'));",
              "",
              "// Chains into the next request, same pattern as the auth token above.",
              "pm.collectionVariables.set('lastOrderId', body.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Get Order By Id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": "{{baseUrl}}/orders/{{lastOrderId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returned order id matches requested id', () => {",
              "  pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('lastOrderId'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Reject Missing Auth (negative test)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// A real regression test: proves the endpoint STAYS protected.",
              "// If someone accidentally removes the auth middleware later,",
              "// this is the test that catches it.",
              "pm.test('Status is 401 without a token', () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Reject Invalid Order Body (negative test)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"item\": \"Missing quantity\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400 for invalid body', () => pm.response.to.have.status(400));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
